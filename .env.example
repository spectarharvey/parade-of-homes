# --- Database (Neon Postgres) ---
# Create a free project at https://neon.tech, then copy the *pooled* connection string.
# It looks like: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_qfspGmBF1tO4@ep-icy-river-aokj8ox2.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# --- Seed admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL="admin@mcbia.org"
ADMIN_PASSWORD="parade2025"

# --- Seed demo builder account (for the builder portal) ---
BUILDER_EMAIL="builder@heritagehomes.com"
BUILDER_PASSWORD="builder2025"

# --- Cloudinary (image uploads in the admin) ---
# From your Cloudinary dashboard. Either set the single CLOUDINARY_URL…
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# …or the three individual variables instead:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- PayPal (entry & sponsor form payments, Orders v2) ---
# Create a REST app at https://developer.paypal.com/dashboard/applications.
# Use "sandbox" while testing, then switch to "live" with live-app credentials.
# PAYPAL_ENV="sandbox"
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# Public client id for the browser SDK — must match PAYPAL_CLIENT_ID's app.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Email (registration verification codes, via Resend) ---
# Sign up at https://resend.com and create an API key. Without this key, the
# verification code is NOT emailed — it's logged to the server console and shown
# on-screen in dev so the flow stays testable.
# RESEND_API_KEY=""
# From address. Must be on a domain you've verified in Resend (the shared
# onboarding@resend.dev works for testing to your own account's address).
# EMAIL_FROM="Parade of Homes <noreply@yourdomain.com>"