// Parade of Homes — data model (PostgreSQL / Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BUILDER
}

enum Tier {
  platinum
  gold
  silver
}

enum SubStatus {
  pending
  approved
  rejected
}

model Builder {
  id       String  @id
  name     String
  initials String
  color    String
  featured Boolean @default(false)
  phone    String
  website  String
  years    Int
  blurb    String
  ad       String
  homes    Home[]
  account  Account?
}

model Neighborhood {
  id        String  @id
  name      String
  city      String
  color     String
  img       String
  blurb     String
  low       Int
  high      Int
  /// When false, the public site hides this neighborhood's price range.
  showPrice Boolean @default(true)
  homes     Home[]
}

model Home {
  id           String       @id
  name         String
  color        String       @default("#116799")
  builderId    String
  builder      Builder      @relation(fields: [builderId], references: [id], onDelete: Cascade)
  nbId         String
  neighborhood Neighborhood @relation(fields: [nbId], references: [id], onDelete: Cascade)
  style        String
  price        Int
  beds         Int
  baths        Float
  sqft         Int
  garage       Int
  checkins     Int          @default(0)
  rating       Float
  ratings      Int
  featured     Boolean      @default(false)
  x            Float
  y            Float
  lat          Float?
  lng          Float?
  blurb        String
  address      String       @default("")
  features     String[]
  imgs         String[]
}

model Sponsor {
  id      String @id
  name    String
  tier    Tier
  color   String
  cat     String
  img     String @default("")
  website String @default("")
  phone   String @default("")
  email   String @default("")
  address String @default("")
}

model Faq {
  id    String @id @default(cuid())
  q     String
  a     String
  order Int    @default(0)
}

/// End-user (visitor) registrations. Serialized to the frontend `User` shape.
model Registrant {
  id           String  @id @default(cuid())
  first        String
  last         String
  email        String
  phone        String
  zip          String
  sms          Boolean @default(false)
  passwordHash String? // bcrypt hash; null for legacy passes created before passwords
  checkins     Int     @default(0)
  date         String
}

model Submission {
  id        String    @id @default(cuid())
  builder   String
  home      String
  nb        String
  style     String
  price     Int
  beds      Int
  baths     Float
  sqft      Int
  status    SubStatus @default(pending)
  date      String
  contact   String
  blurb     String    @default("")
  imgs      String[]  @default([])
  builderId String?
}

model Notification {
  id       String @id @default(cuid())
  type     String
  msg      String
  audience String
  sent     String
  count    Int
}

/// Single-row table holding contest configuration.
model Contest {
  id     Int    @id @default(1)
  target Int
  prize  String
}

/// 2026 Parade Builder Model Home Entry Form submissions (public).
/// Long-tail fields (features, sub-contractors, sale price, listing agent,
/// finding instructions) are stored in `details`.
model BuilderEntry {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  status         String   @default("NEW") // NEW | REVIEWED | APPROVED | ARCHIVED

  // Main contact (MCBIA's internal point of contact)
  contactName    String
  contactPhone   String
  contactEmail   String

  // Builder (shown to the public)
  builderName    String
  builderContact String?
  builderPhone   String
  builderEmail   String
  website        String
  officeAddress  String?
  license        String

  // Model home
  modelName      String
  sqftLiving     String
  sqftTotal      String
  beds           String
  baths          String
  garage         String
  subdivision    String?
  modelAddress   String?
  price          String
  buildType      String
  staged         String

  // Entry / billing
  entryLevel     String
  paymentMethod  String
  signature      String
  billingName    String?
  receiptEmail   String?
  billingAddress String?

  // Uploads (Cloudinary URLs)
  frontElevation String?
  logo           String?
  floorPlan      String?

  details Json?
}

/// 2026 Parade Sponsor Form submissions (public).
model SponsorEntry {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  status         String   @default("NEW")

  // Contact person for the ad
  contactName    String
  contactPhone   String
  contactEmail   String

  // Company (shown to the public)
  companyName    String
  companyPhone   String
  companyEmail   String
  website        String
  companyAddress String?

  // Level / billing
  level          String
  paymentMethod  String
  signature      String
  billingName    String?
  billingEmail   String?
  billingAddress String?

  // Uploads (Cloudinary URLs)
  logo String?
  ad   String?

  details Json?
}

/// Auth accounts for admin + builder portal (Phase 2).
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  builderId    String?  @unique
  builder      Builder? @relation(fields: [builderId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

/// Editable website copy + imagery, managed from Admin → Website Content.
/// `page` is either "global" (the shared header/footer) or a page slug such as
/// "home"; `key` is a dot-path within that page. A row is an OVERRIDE only —
/// when no row exists the page renders its built-in default from
/// src/lib/cms/schema, which is why "Reset to default" simply deletes the row.
model SiteContent {
  id        String   @id @default(cuid())
  page      String
  key       String
  /// text | textarea | multiline | html | image | url — drives the admin widget.
  type      String   @default("text")
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page])
}
